# Copy this file to .env and fill in your real values.
# (In most hosting dashboards — Hostinger, Render, Railway — you set
# these as "Environment Variables" in their web panel instead of a .env
# file; either way works, this file is just a reference of what's needed.)

# Session security — any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

NODE_ENV=production

# ---------------------------------------------------------------------
# MySQL — REQUIRED for production. Without these, the app falls back to
# storing everything in local JSON files under /data, which is NOT safe
# on most managed hosting (Hostinger, Render, etc.) — a redeploy can wipe
# that data. See CHANGES.md for the full explanation and Hostinger setup
# steps.
# ---------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---------------------------------------------------------------------
# OPTIONAL — powers the chatbot's "Apna Sawaal Poochein" (free-text AI
# chat) option. Without this, that one menu option shows a friendly
# "having trouble right now" message and everything else on the site
# works completely normally.
#
# Together AI (https://together.ai) — Llama 3.1 8B Instruct Turbo is
# their cheapest model (~$0.18 per million tokens either direction), and
# they give $5 free credit on signup, which alone covers a very large
# number of conversations at this scale.
# ---------------------------------------------------------------------
TOGETHER_API_KEY=
